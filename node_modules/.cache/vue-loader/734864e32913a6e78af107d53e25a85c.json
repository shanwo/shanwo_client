ACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"editDetail.vue","sourceRoot":"src/views/myShan/editShan/editLink","sourcesContent":["<template>\n  <div class=\"detail_container\">\n    <Header :backBg=\"true\">\n      <div class=\"save_btn dfcen\">保存</div>\n    </Header>\n    <!-- 链接按钮样式 -->\n    <div class=\"link_view\">\n      <img class=\"close_img\" src=\"@/assets/images/myShan/close.png\" alt=\"\" @click=\"deleteLink\">\n    </div>\n    <!-- 修改链接内容 -->\n    <div class=\"edit_link_con\">\n      <div class=\"link_btn dfcen\" @click=\"show = !show\">\n        <div class=\"btn_label\">按钮图标</div>\n        <div class=\"btn_imgs\">\n          <img src=\"@/assets/images/myShan/noticon.png\" alt=\"\" class=\"btn_icon\">\n          <img src=\"@/assets/images/my/HomeIconRightArrow@2x.png\" class=\"next_icon\">\n        </div>\n      </div>\n      <div class=\"btn_label title\">按钮文字</div>\n      <input type=\"text\" placeholder=\"请输入按钮文字\">\n      <div class=\"btn_label title\">跳转链接</div>\n      <input type=\"text\" placeholder=\"请输入按钮链接\">\n      <div class=\"sjhy dfcen\" @click=\"$router.push('/linkGuide')\">\n\t\t\t\t<span>如何获取链接</span>\n\t\t\t\t<img class=\"next_icon\" src=\"@/assets/images/myShan/right_icon.png\"></img>\n\t\t\t</div>\n    </div>\n\t\t<!-- 删除弹层 -->\n    <tipPopup ref=\"delete\" @handleClickOkey=\"handleClickOkey\"></tipPopup>\n\t\t<!-- 获取图标弹层 -->\n\t\t<van-popup v-model=\"show\" round position=\"bottom\" :style=\"{ height: '4rem' }\">\n\t\t\t<div class=\"icon_set_view dfcen\">\n\t\t\t\t<div class=\"icon_item_view dfcen\" @click=\"$router.push('/icons')\">\n\t\t\t\t\t<img src=\"@/assets/images/myShan/icons.png\">\n\t\t\t\t\t<span>图标库</span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"icon_item_view dfcen\">\n\t\t\t\t\t<img src=\"@/assets/images/myShan/photos.png\">\n\t\t\t\t\t<span>手机相册</span>\n\t\t\t\t\t<input\n\t\t\t\t\t\ttype=\"file\"\n\t\t\t\t\t\tname=\"img\"\n\t\t\t\t\t\taccept=\"image/*\"\n\t\t\t\t\t\tref=\"upup\"\n\t\t\t\t\t\t@change=\"uploadImg($event, 2)\"\n\t\t\t\t\t/>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"icon_item_view dfcen\" @click=\"show = !show\">\n\t\t\t\t\t<img src=\"@/assets/images/myShan/delete.png\">\n\t\t\t\t\t<span>不使用图标</span>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</van-popup>\n\t\t<cropper ref=\"cropper\" @updateImgUrl=\"updateImgUrl\" :fromType=\"1\"></cropper>\n  </div>\n</template>\n<script>\nimport Header from \"@/components/common/header.vue\"\nimport tipPopup from \"@/components/common/tipPopup.vue\"\nimport cropper from \"@/components/common/cropper\";\nimport { Popup } from 'vant';\n  export default {\n    data() {\n      return {\n        id: '',\n\t\t\t\tshow: false\n      }\n    },\n    components: {\n\t\t\t[Popup.name]: Popup,\n\t\t\tcropper,\n      Header,\n      tipPopup\n    },\n    mounted() {\n      this.id = this.$route.query.id\n    },\n    methods: {\n      // 删除链接\n      deleteLink() {\n\t\t\t\tthis.$refs.delete.show = true\n      },\n\t\t\t// 确认删除\n\t\t\thandleClickOkey() {\n\t\t\t\tthis.$router.back()\n\t\t\t},\n\t\t\tuploadImg(e, code) {\n\t\t\t\tconsole.log(e, code)\n\t\t\t\t// 选择原图之后\n\t\t\t\tthis.$refs.cropper.upphoto(e, code);\n\t\t\t\tthis.show = false\n\t\t\t\t// e.target.value = \"\";\n\t\t\t},\n\t\t\t// 上传图片之后的回调，获取图片地址\n\t\t\tupdateImgUrl(data) {\n\t\t\t\tconsole.log(data)\n\t\t\t}\n    }\n  }\n</script>\n<style lang=\"less\" scoped>\n.detail_container {\n  min-height: 100vh;\n  background: linear-gradient(135deg, #A8F2C5 0%, #9AD1CD 100%);\n  display: flex;\n  flex-direction: column;\n  .save_btn {\n    width: 68px;\n    height: 28px;\n    border-radius: 8px;\n    color: #1FB1A6;\n    background: #fff;\n    font-size: 14px;\n  }\n  .link_view {\n    width: 328px;\n    height: 60px;\n    background: red;\n    position: relative;\n    margin: 0 auto;\n    .close_img {\n      width: 32px;\n      height: 32px;\n      position: absolute;\n      right: -16px;\n      top: -16px;\n    }\n  }\n  .edit_link_con {\n    width: 328px;\n    flex: 1;\n    background: #fff;\n    margin: 14px auto 0;\n    border-radius: 16px 16px 0 0;\n    box-shadow: 0px 0px 20px 0px rgba(0, 0, 0, .2);\n    padding: 10px 14px 0;\n    box-sizing: border-box;\n    .link_btn {\n      height: 56px;\n      border-bottom: 1px solid #E5E5E5;\n    }\n    .btn_imgs {\n      flex: 1;\n      display: flex;\n      justify-content: flex-end;\n      align-items: center;\n      .btn_icon {\n        width: 48px;\n        height: 48px;\n      }\n      .next_icon {\n        width: 16px;\n        height: 16px;\n        margin-left: 2px;\n      }\n    }\n    .title {\n      line-height: 55px;\n    }\n    input {\n      border: 1px solid #9ED7D3;\n      width: 100%;\n      height: 50px;\n      padding: 0 12px;\n      border-radius: 8px;\n      box-sizing: border-box;\n    }\n    .sjhy {\n      color: #4ABDB5;\n      margin-top: 15px;\n      justify-content: flex-end;\n      .next_icon {\n        width: 6.33px;\n        height: 11.83px;\n        margin-left: 5px;\n      }\n    }\n  }\n\t.icon_set_view {\n\t\theight: 100%;\n\t\t.icon_item_view {\n\t\t\tflex: 1;\n\t\t\tflex-direction: column;\n\t\t\tcolor: #84899D;\n\t\t\tfont-size: 14px;\n\t\t\tposition: relative;\n\t\t\tinput {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tposition: absolute;\n\t\t\t\tleft: 0;\n\t\t\t\ttop: 0;\n\t\t\t\topacity: 0;\n\t\t\t}\n\t\t\timg {\n\t\t\t\twidth: 32px;\n\t\t\t\theight: 32px;\n\t\t\t\tmargin-bottom: 10px;\n\t\t\t}\n\t\t}\n\t}\n}\n</style>"]}]}