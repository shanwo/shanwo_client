  position: absolute;\n            left: 50%;\n            top: 50%;\n            transform: translate(-50%, -50%);\n            z-index: 9;\n          }\n          .head_img {\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            box-sizing: border-box;\n            border: 2px solid #E5E5E5;\n          }\n          .icon_img {\n            width: 14px;\n            height: 14px;\n            position: absolute;\n            right: 0;\n            bottom: 0;\n            z-index: 10;\n          }\n        }\n        .user_name {\n          color: #F2F2F2;\n          font-size: 18px;\n          margin-bottom: 7px;\n        }\n        .user_des {\n          color: #EDEDED;\n          font-size: 12px;\n\t\t\t\t\tmargin: 0 12px;\n        }\n      }\n    }\n  }\n</style>"]}]}