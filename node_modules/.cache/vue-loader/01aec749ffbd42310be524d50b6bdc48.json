\n      <img class=\"del_tip\" src=\"@/assets/images/public/del_tip.png\" alt=\"\">\n      <div class=\"des\">{{ tip }}</div>\n      <div class=\"btns\">\n        <div class=\"cancel dfcen\" @click=\"show = false\" v-if=\"hasCancel\">取消</div>\n        <div class=\"okey dfcen\" @click=\"handleClickOkey\">{{ okeyTxt }}</div>\n      </div>\n    </div>\n  </van-popup>\n</template>\n<script>\nimport { Popup } from 'vant';\nexport default {\n\tprops: {\n\t\ttip: {\n\t\t\ttype: String,\n\t\t\tdefault: '你确定要删除链接吗?'\n\t\t},\n\t\thasCancel: {\n\t\t\ttype: Boolean,\n\t\t\tdefault: true\n\t\t},\n\t\tokeyTxt: {\n\t\t\ttype: String,\n\t\t\tdefault: '确定'\n\t\t}\n\t},\n  data() {\n    return {\n      show: false\n    }\n  },\n\tmethods: {\n\t\t// 确定\n\t\thandleClickOkey() {\n\t\t\tthis.$emit('handleClickOkey')\n\t\t},\n\t},\n  components: {\n    [Popup.name]: Popup\n  }\n}\n</script>\n<style lang=\"less\" scoped>\n.popup_container {\n  width: 310px;\n  height: 330px;\n  position: relative;\n  flex-direction: column;\n  .close {\n    width: 24px;\n    height: 24px;\n    position: absolute;\n    right: 16px;\n    top: 16px;\n  }\n  .del_tip {\n    width: 88px;\n    height: 88px;\n    margin-bottom: 28px;\n  }\n  .des {\n    color: #84899D;\n    font-size: 16px;\n    margin-bottom: 60px;\n\t\ttext-align: center;\n\t\tpadding: 0 18px;\n  }\n  .btns {\n    display: flex;\n\t\twidth: 100%;\n\t\tpadding: 0 20px;\n\t\tbox-sizing: border-box;\n    .cancel, .okey {\n      // width: 138px;\n\t\t\tflex: 1;\n      height: 60px;\n      color: #29B4AA;\n      font-size: 18px;\n    }\n    .okey {\n      background: linear-gradient(323deg, #00A89C 0%, #93D2CD 100%);\n      border-radius: 30px;\n      color: #fff;\n    }\n  }\n}\n</style>"]}]}