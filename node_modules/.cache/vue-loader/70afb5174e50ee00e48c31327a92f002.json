50\"\n\t\t\t\t>\n\t\t\t\t\t<card :list=\"hotList\"></card>\n\t\t\t\t</van-list>\n      </van-tab>\n      <van-tab title=\"最近更新\">\n       <van-list\n          v-model=\"recentLoading\"\n          :finished=\"recentFinished\"\n          finished-text=\"没有更多了\"\n          @load=\"getRecentList\"\n        \toffset=\"50\"\n        >\n        \t<card :list=\"recentList\"></card>\n        </van-list>\n      </van-tab>\n    </van-tabs>\n  </div>\n</template>\n<script>\n  import { Tab, Tabs, List } from 'vant';\n  import card from \"@/components/home/card.vue\"\n\timport axios from \"axios\";\n  export default {\n    components: {\n      card,\n      [Tab.name]: Tab,\n      [Tabs.name]: Tabs,\n      [List.name]: List\n    },\n    data() {\n      return {\n        active: 0,\n\t\t\t\t// 热门\n\t\t\t\thotPage: 1,\n\t\t\t\thotList: [],\n\t\t\t\thotLoading: false,\n\t\t\t\thotFinished: false,\n\t\t\t\t// 最近更新\n\t\t\t\trecentPage: 1,\n\t\t\t\trecentList: [],\n\t\t\t\trecentLoading: false,\n\t\t\t\trecentFinished: false,\n      }\n    },\n\t\tmethods: {\n\t\t\t// 获取热门列表\n\t\t\tgetHotList() {\n\t\t\t\tif(this.hotFinished) {\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tthis.$myAjax(`${this.$api.getHot}?page=${this.hotPage}`, 'GET', {}, res => {\n\t\t\t\t\tif(res.lists.length == 0) {\n\t\t\t\t\t\tthis.hotFinished = true\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\tthis.hotLoading = false\n\t\t\t\t\tthis.hotList = [...this.hotList, ...res.lists]\n\t\t\t\t\tthis.hotPage += 1\n\t\t\t\t})\n\t\t\t},\n\t\t\t// 获取最近更新列表\n\t\t\tgetRecentList() {\n\t\t\t\tif(this.recentFinished) {\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tthis.$myAjax(`${this.$api.getRecent}?page=${this.recentPage}`, 'GET', {}, res => {\n\t\t\t\t\tif(res.lists.length == 0) {\n\t\t\t\t\t\tthis.recentFinished = true\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\tthis.recentLoading = false\n\t\t\t\t\tthis.recentList = [...this.recentList, ...res.lists]\n\t\t\t\t\tthis.recentPage += 1\n\t\t\t\t})\n\t\t\t}\n\t\t}\n  }\n</script>\n<style lang=\"less\">\n  .home_container {\n    .van-tab {\n      flex: none;\n      padding: 0 15px;\n      font-size: 16px;\n    }\n    .van-tab--active {\n      font-size: 24px;\n      line-height: 24px;\n    }\n    .van-tabs__line {\n      width: 20px;\n      height: 4px;\n      background: #333333;\n      bottom: 20px;\n    }\n    .van-tabs__wrap {\n      height: 54px;\n    }\n  }\n</style>"]}]}