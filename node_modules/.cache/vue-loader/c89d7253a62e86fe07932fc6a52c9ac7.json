=\"icon_view\">\n          <div class=\"icons_scroll\">\n            <div class=\"icon_item\" v-for=\"(item, i) in 20\" :key=\"i\">\n              <img src=\"@/assets/images/home/check.png\" mode=\"\" class=\"icon_img\"></img>\n            </div>\n          </div>\n        </div>\n        <div class=\"title_view\">挂件</div>\n        <div class=\"gj_view\">\n          <div class=\"gj_scroll\">\n            <img v-for=\"(item, i) in 20\" :key=\"i\" src=\"https://img11.360buyimg.com/n7/jfs/t1/94448/29/2734/524808/5dd4cc16E990dfb6b/59c256f85a8c3757.jpg\" alt=\"\">\n          </div>\n        </div>\n      </div>\n      <div class=\"border_view user_name_view dfcen\">\n        <div class=\"name\">姓名:</div>\n        <input type=\"text\" placeholder=\"请输入姓名\">\n      </div>\n      <div class=\"border_view des_view\">\n        <img src=\"@/assets/images/myShan/info.png\" alt=\"\">\n        <textarea placeholder=\"请输入简介\" rows=\"6\" maxlength=\"100\" v-model=\"des\"></textarea>\n        <div class=\"font_count\">\n          {{ des.length }}/100\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nimport Header from \"@/components/common/header.vue\"\n  export default {\n    data() {\n      return {\n        name: '',\n        des: ''\n      }\n    },\n    components: {\n      Header\n    }\n  }\n</script>\n<style lang=\"less\" scoped>\n.edit_head {\n  min-height: 100vh;\n  background: #F6F7F9;\n  .save_btn {\n    background: linear-gradient(323deg, #00A89C 0%, #93D2CD 100%);\n    width: 68px;\n    height: 28px;\n    border-radius: 8px;\n    color: #fff;\n  }\n  .head_content {\n    padding: 0 12px 20px;\n    font-size: 14px;\n    .border_view {\n      border: 1px solid #9ED7D3;\n      border-radius: 8px;\n      margin-bottom: 14px;\n    }\n    .head_edit_view {\n      padding: 12px;\n      .title_view {\n        color: #666666;\n        font-size: 16px;\n      }\n      .head_view {\n        height: 120px;\n        .head_img_view {\n          width: 88px;\n          height: 88px;\n          position: relative;\n          .user_head {\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            border: 2px solid #E5E5E5;\n          }\n          .decorate_img {\n            width: 146px;\n            height: 146px;\n            position: absolute;\n            left: 50%;\n            top: 50%;\n            transform: translate(-50%, -50%);\n          }\n          .icon_img {\n            width: 16px;\n            height: 16px;\n            position: absolute;\n            right: 0;\n            bottom: 0;\n          }\n        }\n      }\n      .icon_view {\n        margin-top: 20px;\n        height: 33px;\n        overflow: scroll;\n        border-bottom: 1px solid #E5E5E5;\n        margin-bottom: 16px;\n        .icons_scroll {\n          display: flex;\n          height: 100%;\n          .icon_item {\n            height: 100%;\n            img {\n              width: 18px;\n              height: 18px;\n              margin-right: 24px;\n            }\n          }\n        }\n      }\n      .gj_view {\n        height: 88px;\n        overflow: scroll;\n         margin: 10px 0;\n        .gj_scroll {\n          display: flex;\n          img {\n            width: 88px;\n            height: 88px;\n            margin-right: 6px;\n          }\n        }\n      }\n    }\n    .user_name_view {\n      height: 52px;\n      padding: 0 12px;\n      .name {\n        color: #4ABDB5;\n        font-size: 14px;\n        margin-right: 8px;\n      }\n      input {\n        flex: 1;\n      }\n    }\n    .des_view {\n      padding: 10px 10px 24px;\n      display: flex;\n      position: relative;\n      img {\n        width: 32px;\n        height: 32px;\n        margin-right: 9px;\n      }\n      textarea {\n        padding-top: 6px;\n        flex: 1;\n      }\n      .font_count {\n        position: absolute;\n        right: 10px;\n        bottom: 10px;\n        color: #B4B8C9;\n        font-size: 12px