\n      },\n      // 修改链接内容\n      editLink(item) {\n        let url = item ? `/editDetail?id=${item}` : `/editDetail`\n        this.$router.push(url)\n      }\n    }\n  }\n</script>\n<style lang=\"less\" scoped>\n.link_cointainer {\n  min-height: 100vh;\n  background: linear-gradient(135deg, #38EF7D 0%, #11998E 100%);\n  .save_btn {\n    width: 68px;\n    height: 28px;\n    border-radius: 8px;\n    color: #1FB1A6;\n    background: #fff;\n    font-size: 14px;\n  }\n  .link_item {\n    width: 328px;\n    height: 60px;\n    background: #ccc;\n    margin: 0 auto 16px;\n  }\n  .add_btn {\n    width: 328px;\n    height: 60px;\n    border: 1px dashed #fff;\n    border-radius: 30px;\n    margin: 0 auto;\n    color: #fff;\n    font-size: 16px;\n  }\n}\n</style>"]}]}