iew {\n    padding: 0 24px;\n    font-size: 16px;\n    color: #333333;\n    .info_view {\n      border-bottom: 1px solid #e5e5e5;\n      height: 56px;\n      input {\n        text-align: right;\n      }\n    }\n  }\n}\n</style>\n"]}]}